generator client {
  provider = "prisma-client"
  output = "../src/adapters/outbound/persistence/generated/prisma"
}

datasource db {
  provider = "postgresql"
  relationMode = "prisma"
}

model BetOutboxEvents {
  betOutboxEventId String @id @map("bet_outbox_event_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  messageId String @map("message_id") @db.Uuid
  eventType String @map("event_type")
  subjectId String @map("subject_id") @db.Uuid
  payload Json @map("payload")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  attemptCount Int @map("attempt_count")
  nextAttemptAt DateTime @map("next_attempt_at") @db.Timestamptz(6)
  leaseId String? @map("lease_id") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  @@map("bet_outbox_events")
}

model BetInboxEvents {
  betInboxEventId String @id @map("bet_inbox_event_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  source String @map("source")
  messageId String @map("message_id") @db.Uuid
  payloadHash String @map("payload_hash")
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  status String @map("status")
  @@map("bet_inbox_events")
}

model Bets {
  betId String @id @map("bet_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  playerId String @map("player_id") @db.Uuid
  clientRequestId String @map("client_request_id") @db.Uuid
  betType String @map("bet_type")
  status String @map("status")
  stakeMinor BigInt @map("stake_minor")
  currency String @map("currency") @db.Char(3)
  combinedOdds Decimal? @map("combined_odds") @db.Decimal(18, 8)
  potentialPayoutMinor BigInt @map("potential_payout_minor")
  actualPayoutMinor BigInt? @map("actual_payout_minor")
  reservationRef String? @map("reservation_ref") @db.Uuid
  rejectionCode String? @map("rejection_code")
  sourceChannel String @map("source_channel")
  version BigInt @map("version")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)
  @@map("bets")
}

model BetLegs {
  betLegId String @id @map("bet_leg_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  betId String @map("bet_id") @db.Uuid
  legNo Int @map("leg_no") @db.SmallInt
  eventId String @map("event_id") @db.Uuid
  marketId String @map("market_id") @db.Uuid
  selectionId String @map("selection_id") @db.Uuid
  quoteId String? @map("quote_id") @db.Uuid
  quoteVersion BigInt? @map("quote_version")
  acceptedOdds Decimal? @map("accepted_odds") @db.Decimal(18, 8)
  selectionSnapshot Json @map("selection_snapshot")
  status String @map("status")
  resultRef String? @map("result_ref") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  @@map("bet_legs")
}

model BetSettlements {
  betSettlementId String @id @map("bet_settlement_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  betId String @map("bet_id") @db.Uuid
  resultRef String @map("result_ref") @db.Uuid
  settlementSeq BigInt @map("settlement_seq")
  decision String @map("decision")
  payoutMinor BigInt @map("payout_minor")
  ledgerCommandId String @map("ledger_command_id") @db.Uuid
  status String @map("status")
  attemptCount Int @map("attempt_count")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(6)
  @@map("bet_settlements")
}

model BetStateChanges {
  betStateChangeId String @id @map("bet_state_change_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  betId String @map("bet_id") @db.Uuid
  fromStatus String @map("from_status")
  toStatus String @map("to_status")
  reasonCode String? @map("reason_code")
  actorType String @map("actor_type")
  actorId String @map("actor_id") @db.Uuid
  correlationId String @map("correlation_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  @@map("bet_state_changes")
}

model BetCommands {
  betCommandId String @id @map("bet_command_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  requestId String @map("request_id") @db.Uuid
  operation String @map("operation")
  payloadHash String @map("payload_hash")
  actorId String @map("actor_id") @db.Uuid
  actorKind String @map("actor_kind")
  playerId String? @map("player_id") @db.Uuid
  semanticInput Json @map("semantic_input")
  stableChildIds Json @map("stable_child_ids")
  responseSnapshot Json? @map("response_snapshot")
  state String @map("state")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  betId String? @map("bet_id") @db.Uuid
  @@map("bet_commands")
}

model BetEventResults {
  betEventResultId String @id @map("bet_event_result_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  resultId String @map("result_id") @db.Uuid
  resultSeq BigInt @map("result_seq")
  payloadHash String @map("payload_hash")
  snapshot Json @map("snapshot")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  @@map("bet_event_results")
}

model BetSettlementSweeps {
  betSettlementSweepId String @id @map("bet_settlement_sweep_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  resultId String @map("result_id") @db.Uuid
  cursor String? @map("cursor")
  state String @map("state")
  version BigInt @map("version")
  leaseId String? @map("lease_id") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)
  @@map("bet_settlement_sweeps")
}

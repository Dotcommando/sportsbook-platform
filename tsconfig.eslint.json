{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-test/**",
    "**/build/**",
    "**/coverage/**",
    "packages/generated/**",
    "**/generated/**",
    "plans/**",
    "experiments/results/**",
    "artifacts/**",
    ".tmp/**",
    ".temp/**",
    "data/**"
  ]
}
